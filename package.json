{
  "name": "@osa/dumont-agent",
  "version": "0.1.0",
  "description": "AI-powered charter brokerage engine for Orange Sunshine Aviation",
  "type": "module",
  "main": "dist/orchestrator/index.js",
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && echo 'root: skip'",
    "test": "vitest run",
    "test:all": "npm test && npm test --workspaces --if-present",
    "test:watch": "vitest",
    "sim": "tsx src/run-sim.ts",
    "deal": "tsx src/run-deal.ts",
    "dashboard": "cd dashboard && npx vite --open",
    "dashboard:build": "cd dashboard && npx vite build",
    "typecheck": "tsc --noEmit",
    "server": "npx tsx src/server/index.ts",
    "ingest:faa": "tsx src/ingestion/faa-ingest.ts",
    "ingest:icao": "tsx src/ingestion/icao-hex-ingest.ts",
    "opensky": "tsx src/ingestion/opensky-worker.ts",
    "ingest:history": "tsx src/ingestion/adsblol-ingest.ts",
    "ingest:parquet": "tsx src/ingestion/parquet-ingest.ts",
    "adsb:live": "tsx src/ingestion/adsblol-live-worker.ts",
    "faa:diff": "tsx src/ingestion/faa-daily-diff.ts",
    "ingest:docindex": "tsx src/ingestion/faa-docindex-ingest.ts",
    "pipeline": "tsx src/ingestion/pipeline.ts",
    "ingest:airmen": "tsx src/ingestion/airmen-ingest.ts",
    "eval:quote": "tsx src/eval/quote-eval.ts",
    "health:check": "tsx src/monitoring/health-check.ts",
    "ingest:listings": "tsx src/ingestion/listing-tracker.ts",
    "export:targets": "tsx src/ingestion/target-companies.ts",
    "backfill:history": "tsx src/ingestion/history-backfill.ts",
    "ingest:operators": "tsx src/ingestion/faa-operators-full.ts",
    "ingest:safety": "tsx src/ingestion/safety-ratings.ts",
    "mcp:serve": "tsx src/mcp/server.ts",
    "mcp:sse": "tsx src/mcp/server-sse.ts",
    "archive:adsb": "tsx src/ingestion/archive-adsb-raw.ts",
    "analytics:build": "tsx src/analytics/wingx-engine.ts",
    "ingest:faa-full": "tsx src/ingestion/faa-full-ingest.ts",
    "ingest:ntsb": "tsx src/ingestion/ntsb-ingest.ts",
    "archive:faa": "tsx src/ingestion/archive-faa-raw.ts",
    "quality:check": "tsx src/analytics/data-quality.ts",
    "db:migrate-pg": "tsx src/memory/migrate-pg.ts",
    "db:migrate-data": "tsx src/memory/migrate-data.ts",
    "embeddings:build": "tsx src/analytics/embeddings.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/lib-storage": "^3.1029.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "duckdb": "^1.4.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "pg": "^8.20.0",
    "pg-cursor": "^2.19.0",
    "tar": "^7.5.13",
    "ulid": "^3.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/pg-cursor": "^2.7.2",
    "@types/tar": "^6.1.13",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "UNLICENSED"
}
